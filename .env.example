# Copy to .env.local and fill in every value.
# Supabase project URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/public key (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key — server only, never expose (Dashboard → Project Settings → API)
SUPABASE_SERVICE_ROLE_KEY=
# Google AI API key for Gemini models (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq API key — primary extraction model (https://console.groq.com/keys)
GROQ_API_KEY=
# Resend API key for emails (https://resend.com/api-keys)
RESEND_API_KEY=
# Inbox that receives new-lead sales notifications
SALES_EMAIL=
# Admin dashboard password (single shared password, v1)
ADMIN_PASSWORD=
# Public base URL of the app (used for metadata, sitemap, email links)
APP_URL=
